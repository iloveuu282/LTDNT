<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
  <!-- Một điện thoại USB: tự chuyển tiếp cổng như thao tác adb reverse thủ công. -->
  <Target Name="ConnectUsbPhone" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(OS)' == 'Windows_NT' And Exists('$(LOCALAPPDATA)\Android\sdk\platform-tools\adb.exe')">
    <Exec Command="&quot;$(LOCALAPPDATA)\Android\sdk\platform-tools\adb.exe&quot; -d reverse tcp:5080 tcp:5080" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low" />
  </Target>
</Project>
